{
  "manifest_version": 3,
  "name": "Acessibilidade Digital",
  "version": "1.0.0",
  "description": "Painel de acessibilidade para dislexia e TDAH em páginas externas.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Acessibilidade Digital",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
